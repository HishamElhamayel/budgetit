# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
#
# `.env.*` rather than `.env*.local`, which covered .env.local but left
# .env.production and .env.development tracked — and eas.json names build
# profiles after exactly those two, so they are the files most likely to appear
# next and the worst ones to commit. The negation has to follow the pattern it
# undoes, or .env.example goes with them.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
.vercel
.env*
!.env.example
