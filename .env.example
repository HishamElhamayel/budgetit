# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API Keys
#
# Both are safe to ship in a client bundle — the publishable key grants no more
# than the row level security policies in supabase/migrations allow. The secret
# key (formerly service_role) bypasses RLS entirely and must never appear here.
#
# EXPO_PUBLIC_ is not decoration: Expo only inlines variables with that prefix
# into the app bundle. Restart the dev server after changing these — they are
# baked in at build time, not read at runtime.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Outbound email (Resend), read by supabase/config.toml and applied to the
# linked project with `supabase config push`.
#
# These two are NOT prefixed with EXPO_PUBLIC_, and that is deliberate: they
# must never be inlined into the app bundle. Nothing in the client sends email —
# the Supabase auth server does, using credentials it holds server-side. A
# Resend key in a shipped bundle is a key anyone can extract and send mail with.
#
# BUDGETIT_MAIL_FROM has to be on a domain verified in the Resend dashboard
# (Domains -> Add Domain, then add the DNS records it gives you). Without that,
# Resend delivers only to the address the Resend account was created with, and
# every other recipient fails.
RESEND_API_KEY=re_your_key_here
BUDGETIT_MAIL_FROM=no-reply@your-verified-domain.com
